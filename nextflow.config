// DIANN Workflow - Base Configuration
// Compatible with Nextflow DSL2

// Enable DSL2
nextflow.enable.dsl = 2

// Default parameters - can be overridden via config files or command line
params {
    // Container settings
    container_registry = 'quay.io/karlssoc/diann'
    diann_version = '2.3.2'
    duckdb_container = 'datacatering/duckdb:v1.1.3'  // DuckDB for parquet operations (has bash)

    // DIA-NN binary path inside container
    // Note: Direct path needed because container ENTRYPOINT interferes with PATH
    // Set to null to auto-compute from diann_version at runtime
    diann_binary = null

    // Default resource settings
    threads = 60

    // Parallel execution mode (for 60-core systems)
    // When true: runs 2 jobs at 30 cores each for better throughput
    // When false: runs 1 job at 60 cores for maximum per-job speed
    parallel_mode = true

    // Output directory
    outdir = 'results'

    // Required parameters (null = must be provided by user via -params-file or --flag)
    fasta = null
    samples = null

    // Iterative quantification settings
    existing_library = null // Path to existing library (if not generating)
    library_name = 'predicted_library'  // Name for generated library
    mbr = false             // Match-between-runs in identification stage
    mbr_final = true        // Match-between-runs in final stage

    // SLURM settings (can be overridden)
    slurm_account = null
    slurm_queue = null      // IMPORTANT: Set this if your SLURM requires a partition (-p flag)
                            // Example: slurm_queue = 'long' for long-running jobs
                            // Without this, jobs may fail or use restrictive default partition
    slurm_nodelist = null   // Optional: Specific node(s) to use (--nodelist flag)
                            // Example: slurm_nodelist = 'alap759' to use only that node
                            // WARNING: Using a specific node reduces parallelism

    // Optional model files for tuned workflows
    tokens = null
    rt_model = null
    im_model = null
    fr_model = null

    // Pre-trained model presets
    model_preset = null

    // Model tuning mode
    tuning_mode = 'from_scratch'

    // Optional workflow parameters
    library = null          // Map of library search space params, or path for quantify_only
    subdir = null
    ref_library = null      // Reference library for batch calibration

    // Library generation defaults
    library_subdir = 'library'

    // Quantification parameters
    quantify_subdir = ''    // Output subdirectory for quantification results
    qvalue = 0              // Precursor q-value (0 = DIA-NN default 0.01)
    pg_level = 1            // Protein group level (1=proteins, 0=genes)
    mass_acc_cal = null     // Mass accuracy calibration (null = DIA-NN auto)
    mass_acc = null         // MS2 mass accuracy in ppm (null = auto: 15 for Bruker .d, DIA-NN auto otherwise)
    mass_acc_ms1 = null     // MS1 mass accuracy in ppm (null = auto: 15 for Bruker .d, DIA-NN auto otherwise)
    smart_profiling = false // Smart profiling for quantification
    matrices = true         // Generate quantification matrices
    individual_mass_acc = false // Per-file mass accuracy calibration
    individual_windows = false  // Per-file RT windows

    // Convert library parameters
    cut = 'K*,R*,!*P'          // Enzyme cleavage sites (for convert_library proteotypic annotation)
    missed_cleavages = 1       // Missed cleavages (for convert_library proteotypic annotation)

    // Tune models parameters
    tune_library = null         // Path to spectral library for tuning
    tuning = null               // Map: [tune_rt: true, tune_im: false, tune_fr: false]

    // Presearch workflow parameters
    presearch_files = 5         // Number of largest files for presearch
    qvalue_presearch = 0.05     // Relaxed FDR for presearch
    presearch_library = null    // Optional narrow search space overrides for presearch

    // Iterative quantification parameters (development workflow)
    calibration_mode = 'none'       // 'none', 'infindia', or 'existing'
    calibration_library = null      // Path to existing calibration library
    calibration_files = 5           // Number of MS files for calibration
    instrument_type = null          // 'hfx' or 'timstof' (null = auto)
    pre_select = 0                  // Limit precursors in InfinDIA (0 = unlimited)
    convert_to_dia = false          // Convert .d/.raw to .dia before presearch
    identify_library = null         // Narrow search space for identification stage
    exclude_charges = null          // Exclude precursor charges from identification
    qvalue_identify = 0             // Q-value for identification stage
    input_library = null            // Path to existing library for reprediction
    ms_files = null                 // MS file list for presearch workflows

    // Dynamic time allocation for quantify jobs
    time_base_hours = 2         // Base time in hours
    time_per_file_minutes = 10  // Additional time per MS file

    // Ultrafast quantification mode (trades some sensitivity for speed)
    ultrafast = false

    // Help message
    help = false
}

// Container configuration (enabled per-profile below)
// singularity {
//     enabled = true
//     autoMounts = true
//     cacheDir = "${HOME}/.singularity/cache"
// }

docker {
    enabled = false
}

// Process defaults
process {
    // Default container for all processes
    container = "${params.container_registry}:${params.diann_version}"

    // Error strategy
    errorStrategy = 'retry'
    maxRetries = 2

    // Default resources
    cpus = 1
    memory = '4 GB'
    time = '1h'
}

// Execution profiles
profiles {
    standard {
        process.executor = 'local'
        singularity {
            enabled = true
            autoMounts = true
            cacheDir = "${HOME}/.singularity/cache"
        }

        process {
            // Process-specific resources for local execution
            withLabel: 'diann_tune' {
                cpus = 10
                memory = '10 GB'
                time = '2h'
            }

            withLabel: 'diann_library' {
                cpus = params.threads
                memory = '30 GB'
                time = '4h'
            }

            withLabel: 'diann_quantify' {
                cpus = params.threads
                memory = { 500.MB * params.threads }
                time = '8h'
            }

            withLabel: 'diann_convert' {
                cpus = 4
                memory = '6 GB'
                time = '1h'
            }

            withLabel: 'duckdb' {
                container = params.duckdb_container
                cpus = 4
                memory = '8 GB'
                time = '30m'
            }
        }
    }

    slurm {
        apptainer {
            enabled = true
            autoMounts = true
            cacheDir = "${HOME}/.apptainer/cache"
        }

        executor {
            name = 'slurm'
            queueSize = 10  // Allow multiple concurrent jobs (conversions, subsetting, quantification)
            exitReadTimeout = '4 min'  // SLURM MinJobAge is 5min, must be less than that
            pollInterval = '15 sec'  // Check job status frequently
            queueStatInterval = '1 min'  // Check queue state frequently
            submitRateLimit = '10 / 1 sec'  // Throttle job submissions
        }

        process {
            executor = 'slurm'
            queue = params.slurm_queue
            clusterOptions = {
                def opts = ['--export=ALL']  // Pass environment (including PATH) to jobs
                if (params.slurm_account) opts << "--account=${params.slurm_account}"
                if (params.slurm_nodelist) opts << "--nodelist=${params.slurm_nodelist}"
                opts.join(' ')
            }
            // Set Apptainer temp dir to data disk (runs before container starts)
            beforeScript = 'export APPTAINER_TMPDIR=/srv/data1/$USER/apptainer_tmp'

            // Process-specific resources
            withLabel: 'diann_tune' {
                cpus = 10  // Tuning is not CPU-intensive, keep at 10
                memory = '10 GB'
                time = '2h'
            }

            withLabel: 'diann_library' {
                // Parallel mode: 30 cores allows 2 jobs concurrently (60 total)
                // Sequential mode: 60 cores for maximum speed per job
                cpus = params.parallel_mode ? 30 : params.threads
                memory = params.parallel_mode ? '20 GB' : '30 GB'
                time = '4h'
                maxForks = params.parallel_mode ? 2 : 1
            }

            withLabel: 'diann_quantify' {
                // Parallel mode: 30 cores allows 2 samples concurrently (60 total)
                // Sequential mode: 60 cores for maximum speed per sample
                cpus = params.parallel_mode ? 30 : params.threads
                memory = params.parallel_mode ? 15.GB : (500.MB * params.threads)
                // Note: time is dynamically calculated per job based on file count
                // Formula: time_base_hours + (file_count * time_per_file_minutes)
                // This fallback is only used if dynamic calculation fails
                time = '8h'
                maxForks = params.parallel_mode ? 2 : 1
            }

            withLabel: 'diann_convert' {
                cpus = 4
                memory = '6 GB'
                time = '1h'
            }

            withLabel: 'duckdb' {
                container = params.duckdb_container
                cpus = 4
                memory = '8 GB'
                time = '30m'
            }
        }
    }

    docker {
        process.executor = 'local'
        docker {
            enabled = true
            // Override container ENTRYPOINT to allow Nextflow to run bash scripts
            // See: https://www.nextflow.io/docs/latest/container.html#docker
            runOptions = '-u $(id -u):$(id -g) --platform linux/amd64 --entrypoint=""'
        }

        process {
            // Copy files instead of symlinking (required for Docker on macOS)
            // See: https://www.nextflow.io/docs/latest/reference/process.html#stageinmode
            stageInMode = 'copy'

            // Process-specific resources for local Docker execution
            withLabel: 'diann_tune' {
                cpus = 10
                memory = '10 GB'
                time = '2h'
            }

            withLabel: 'diann_library' {
                cpus = params.threads
                memory = '30 GB'
                time = '4h'
            }

            withLabel: 'diann_quantify' {
                cpus = params.threads
                memory = { 500.MB * params.threads }
                time = '8h'
            }

            withLabel: 'diann_convert' {
                cpus = 4
                memory = '6 GB'
                time = '1h'
            }

            withLabel: 'duckdb' {
                container = params.duckdb_container
                cpus = 4
                memory = '8 GB'
                time = '30m'
            }
        }
    }

    docker_slurm {
        docker {
            enabled = true
            runOptions = '-u $(id -u):$(id -g) --platform linux/amd64'
        }

        executor {
            name = 'slurm'
            queueSize = 10  // Allow multiple concurrent jobs (conversions, subsetting, quantification)
            exitReadTimeout = '4 min'  // SLURM MinJobAge is 5min, must be less than that
            pollInterval = '15 sec'  // Check job status frequently
            queueStatInterval = '1 min'  // Check queue state frequently
            submitRateLimit = '10 / 1 sec'  // Throttle job submissions
        }

        process {
            executor = 'slurm'
            queue = params.slurm_queue
            clusterOptions = {
                def opts = []
                if (params.slurm_account) opts << "--account=${params.slurm_account}"
                if (params.slurm_nodelist) opts << "--nodelist=${params.slurm_nodelist}"
                opts.join(' ')
            }

            // Process-specific resources
            withLabel: 'diann_tune' {
                cpus = 10  // Tuning is not CPU-intensive, keep at 10
                memory = '10 GB'
                time = '2h'
            }

            withLabel: 'diann_library' {
                // Parallel mode: 30 cores allows 2 jobs concurrently (60 total)
                // Sequential mode: 60 cores for maximum speed per job
                cpus = params.parallel_mode ? 30 : params.threads
                memory = params.parallel_mode ? '20 GB' : '30 GB'
                time = '4h'
                maxForks = params.parallel_mode ? 2 : 1
            }

            withLabel: 'diann_quantify' {
                // Parallel mode: 30 cores allows 2 samples concurrently (60 total)
                // Sequential mode: 60 cores for maximum speed per sample
                cpus = params.parallel_mode ? 30 : params.threads
                memory = params.parallel_mode ? 15.GB : (500.MB * params.threads)
                // Note: time is dynamically calculated per job based on file count
                // Formula: time_base_hours + (file_count * time_per_file_minutes)
                // This fallback is only used if dynamic calculation fails
                time = '8h'
                maxForks = params.parallel_mode ? 2 : 1
            }

            withLabel: 'diann_convert' {
                cpus = 4
                memory = '6 GB'
                time = '1h'
            }

            withLabel: 'duckdb' {
                container = params.duckdb_container
                cpus = 4
                memory = '8 GB'
                time = '30m'
            }
        }
    }

    podman {
        process.executor = 'local'
        podman {
            enabled = true
        }
    }

    podman_slurm {
        podman {
            enabled = true
        }

        executor {
            name = 'slurm'
            queueSize = 10  // Allow multiple concurrent jobs (conversions, subsetting, quantification)
            exitReadTimeout = '4 min'  // SLURM MinJobAge is 5min, must be less than that
            pollInterval = '15 sec'  // Check job status frequently
            queueStatInterval = '1 min'  // Check queue state frequently
            submitRateLimit = '10 / 1 sec'  // Throttle job submissions
        }

        process {
            executor = 'slurm'
            queue = params.slurm_queue
            clusterOptions = {
                def opts = []
                if (params.slurm_account) opts << "--account=${params.slurm_account}"
                if (params.slurm_nodelist) opts << "--nodelist=${params.slurm_nodelist}"
                opts.join(' ')
            }

            // Process-specific resources
            withLabel: 'diann_tune' {
                cpus = 10  // Tuning is not CPU-intensive, keep at 10
                memory = '10 GB'
                time = '2h'
            }

            withLabel: 'diann_library' {
                // Parallel mode: 30 cores allows 2 jobs concurrently (60 total)
                // Sequential mode: 60 cores for maximum speed per job
                cpus = params.parallel_mode ? 30 : params.threads
                memory = params.parallel_mode ? '20 GB' : '30 GB'
                time = '4h'
                maxForks = params.parallel_mode ? 2 : 1
            }

            withLabel: 'diann_quantify' {
                // Parallel mode: 30 cores allows 2 samples concurrently (60 total)
                // Sequential mode: 60 cores for maximum speed per sample
                cpus = params.parallel_mode ? 30 : params.threads
                memory = params.parallel_mode ? 15.GB : (500.MB * params.threads)
                // Note: time is dynamically calculated per job based on file count
                // Formula: time_base_hours + (file_count * time_per_file_minutes)
                // This fallback is only used if dynamic calculation fails
                time = '8h'
                maxForks = params.parallel_mode ? 2 : 1
            }

            withLabel: 'diann_convert' {
                cpus = 4
                memory = '6 GB'
                time = '1h'
            }

            withLabel: 'duckdb' {
                container = params.duckdb_container
                cpus = 4
                memory = '8 GB'
                time = '30m'
            }
        }
    }

    cosmos {
        // COSMOS HPC cluster at LUNARC (https://www.lunarc.lu.se/systems/cosmos)
        // Optimized for AMD Milan nodes: 48 cores, 256 GB RAM, 2 TB local disk

        singularity {
            enabled = true
            autoMounts = true
            cacheDir = "${HOME}/.singularity/cache"
        }

        executor {
            name = 'slurm'
            queueSize = 10  // Allow multiple concurrent jobs
            exitReadTimeout = '4 min'
            pollInterval = '15 sec'
            queueStatInterval = '1 min'
            submitRateLimit = '10 / 1 sec'
        }

        process {
            executor = 'slurm'
            queue = params.slurm_queue ?: 'lu'  // Default to 'lu' partition if not specified
            clusterOptions = {
                def opts = []
                if (params.slurm_account) opts << "--account=${params.slurm_account}"
                // Note: slurm_nodelist intentionally not used on shared HPC cluster
                opts.join(' ')
            }

            // Process-specific resources optimized for COSMOS
            withLabel: 'diann_tune' {
                cpus = 10
                memory = '10 GB'
                time = '2h'
                // Use local disk for better I/O performance
                scratch = '$SNIC_TMP'
            }

            withLabel: 'diann_library' {
                // Parallel mode: 24 cores allows 2 jobs concurrently (48 total)
                // Sequential mode: 48 cores for maximum speed per job
                cpus = params.parallel_mode ? 24 : (params.threads <= 48 ? params.threads : 48)
                memory = params.parallel_mode ? '20 GB' : '30 GB'
                time = '4h'
                maxForks = params.parallel_mode ? 2 : 1
                // Library generation is less I/O intensive, scratch optional
            }

            withLabel: 'diann_quantify' {
                // Parallel mode: 24 cores allows 2 samples concurrently (48 total)
                // Sequential mode: 48 cores for maximum speed per sample
                cpus = params.parallel_mode ? 24 : (params.threads <= 48 ? params.threads : 48)
                memory = params.parallel_mode ? 15.GB : (500.MB * (params.threads <= 48 ? params.threads : 48))
                time = '8h'
                maxForks = params.parallel_mode ? 2 : 1
                // CRITICAL: Use local disk for MS file I/O (10-50x faster)
                // COSMOS nodes have 2 TB local disk at $SNIC_TMP
                // Nextflow automatically stages inputs/outputs to/from local disk
                scratch = '$SNIC_TMP'
            }

            withLabel: 'diann_convert' {
                cpus = 4
                memory = '6 GB'
                time = '1h'
            }

            withLabel: 'duckdb' {
                container = params.duckdb_container
                cpus = 4
                memory = '8 GB'
                time = '30m'
            }
        }

        // Override default threads for COSMOS (AMD Milan = 48 cores)
        params {
            threads = 48
        }
    }

    test {
        process {
            executor = 'local'
            cpus = 2
            memory = '4 GB'
        }
        params {
            threads = 2
        }
    }

    // Shared cluster profile - limits concurrent jobs for multi-user environments
    // Usage: -profile slurm,shared
    shared {
        executor {
            queueSize = 5              // Max 5 jobs in queue at once
            submitRateLimit = '10/1min' // Limit submission rate
        }
        process {
            maxForks = 2               // Max 2 parallel instances per process
        }
    }
}

// Execution report settings
timeline {
    enabled = true
    overwrite = true
    file = "${params.outdir}/pipeline_info/execution_timeline.html"
}

report {
    enabled = true
    overwrite = true
    file = "${params.outdir}/pipeline_info/execution_report.html"
}

trace {
    enabled = true
    overwrite = true
    file = "${params.outdir}/pipeline_info/execution_trace.txt"
}

dag {
    enabled = true
    overwrite = true
    file = "${params.outdir}/pipeline_info/pipeline_dag.svg"
}

// Manifest
manifest {
    name = 'diann-workflow'
    author = 'karlssoc'
    description = 'Modular Nextflow workflow for DIA-NN mass spectrometry analysis'
    mainScript = 'main.nf'
    nextflowVersion = '>=21.04.0'
    version = '2.0.0'
}
